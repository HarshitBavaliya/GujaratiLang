{
  "name": "gujarati",
  "displayName": "GujaratiLang",
  "description": "Syntax highlighting for GujaratiLang source files.",
  "version": "0.3.0",
  "publisher": "harshitbavaliya",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/HarshitBavaliya/GujaratiLang/tree/main/editors/vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarshitBavaliya/GujaratiLang.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/HarshitBavaliya/GujaratiLang/issues"
  },
  "keywords": [
    "gujarati",
    "gujaratilang",
    "syntax-highlighting",
    "textmate"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gujarati",
        "aliases": [
          "GujaratiLang",
          "gujarati"
        ],
        "extensions": [
          ".gj"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gujarati",
        "scopeName": "source.gujarati",
        "path": "./syntaxes/gujarati.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gujarati",
        "path": "./snippets/gujarati.code-snippets"
      }
    ]
  }
}
