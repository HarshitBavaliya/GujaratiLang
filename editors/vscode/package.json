{
  "name": "gujarati",
  "displayName": "GujaratiLang",
  "description": "Syntax highlighting for GujaratiLang source files.",
  "version": "0.1.0",
  "publisher": "harshitbavaliya",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gujarati",
        "aliases": [
          "GujaratiLang",
          "gujarati"
        ],
        "extensions": [
          ".gj"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gujarati",
        "scopeName": "source.gujarati",
        "path": "./syntaxes/gujarati.tmLanguage.json"
      }
    ]
  }
}
