{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GujaratiLang",
  "scopeName": "source.gujarati",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.gujarati",
          "begin": "//",
          "end": "$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.gujarati",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.gujarati",
          "match": "\\\\(?:[\"\\\\nrt])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gujarati",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:નહિતર જો|ઘાતક ભૂલ|નહિતર|જ્યાં સુધી|છાપો|આવો|આવજો|નહીં|નકામો|ભૂલ|પરત|જો|અને|અથવા|ચેતવણી|કાર્ય|દરેક|માં|આયાત|nahitar_jo|ghatak_bhul|jya_sudhi|chetavani|chhapo|aavjo|nahitar|athva|nakamo|kary|parat|aavo|ane|nahi|bhul|jo|darek|ma|aayat|import)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.gujarati",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:લંબાઈ|વાંચો|સંખ્યા|લખાણ|પ્રકાર|ઉમેરો|કાપો|શોધો|કાઢો|પહેલી_એબીસીડી|બીજી_એબીસીડી|મહત્તમ|ન્યૂનતમ|ધન_મૂલ્ય|ઉલટાવો|ભાગ|જોડો|સાફ|ઘાત|મૂળ|ગોઠવો|બદલો|શરૂઆત_સાથે|અંત_સાથે|સમાવે_છે|ગોળ|નીચે|ઉપર|પુનરાવર્તન|ટુકડો|સ્થાન|મૂકો|ડાબે_ભરો|જમણે_ભરો|સીમા|યાદચ્છિક|બીજ|વિસ્તારો|પાઈ|ઈ|ચિહ્ન|લઘુગણક|અક્ષર_કોડ|કોડ_થી_અક્ષર|યાદી_ભરો|સરવાળો_યાદી|યાદી_ન્યૂનતમ|યાદી_મહત્તમ|lambai|vancho|sankhya|lakhan|prakar|umero|kapo|shodho|kadho|peli_abcd|biji_abcd|mahatam|nyunatam|dhan_mulya|ultavo|bhag|jodo|saf|ghat|mul|gothvo|badlo|sharuat_sathe|ant_sathe|samave_chhe|gol|niche|upar|punravartan|tukdo|sthan|muko|dabe_bharo|jamne_bharo|sima|yadachhik|beej|vistaro|pi|e|chihna|laghuganak|akshar_kod|kod_thi_akshar|yadi_bharo|sarvalo_yadi|yadi_nyunatam|yadi_mahatam)(?![\\p{L}\\p{M}\\p{N}_])(?=\\s*\\()"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.gujarati",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])[_\\p{L}][_\\p{L}\\p{M}\\p{N}]*(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.gujarati",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:[0-9]+(?:\\.(?!\\.)[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.gujarati",
          "match": "==|!=|<=|>=|[+*/<>=-]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.gujarati",
          "match": "[;,]"
        },
        {
          "name": "punctuation.section.gujarati",
          "match": "[{}()\\[\\].]"
        }
      ]
    }
  }
}