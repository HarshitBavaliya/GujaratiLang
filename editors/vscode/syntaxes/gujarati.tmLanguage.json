      "patterns": [
        {
          "name": "constant.numeric.gujarati",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:[0-9]+(?:\\.(?!\\.)[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.gujarati",
          "match": "\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|[+*/<>=-%?]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.gujarati",
          "match": "[;:,]"
        },
        {
          "name": "punctuation.section.gujarati",
          "match": "[{}()\\[\\].]"
        }
      ]
