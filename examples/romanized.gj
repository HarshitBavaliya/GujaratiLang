// Every keyword below can be typed with an English keyboard.
kary double(value) { parat value * 2; }
items = [1, 2, 3];

darek (item ma items) {
    chhapo double(item);
}

jo (lambai(items) == 3) {
    chhapo "All three items were processed.";
} nahitar {
    chhapo "Unexpected list length.";
}
