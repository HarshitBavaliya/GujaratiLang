આવો
આયાત "stock_helpers.gj";

વસ્તુઓ = ["પેન", "નોટબુક", "રબર"];
જથ્થો = [25, 10, 50];

શોધ = વાંચો("વસ્તુનું નામ દાખલ કરો: ");
મળેલ_જથ્થો = જથ્થો_શોધો(શોધ, વસ્તુઓ, જથ્થો);

જો (મળેલ_જથ્થો >= 0) {
    છાપો "ઉપલબ્ધ જથ્થો:";
    છાપો મળેલ_જથ્થો;
} નહિતર {
    છાપો "વસ્તુ સ્ટોકમાં મળી નથી.";
}

છાપો "સંપૂર્ણ સ્ટોક:";
દરેક (ક્રમ માં 0..લંબાઈ(વસ્તુઓ)) {
    વસ્તુ_દર્શાવો(વસ્તુઓ[ક્રમ], જથ્થો[ક્રમ]);
}
આવજો
